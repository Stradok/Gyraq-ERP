# Copy to .env. Everything the server needs.
DATABASE_URL=postgres://meridian:meridian@localhost:5433/meridian
PORT=4000
# Long random string. Signs login tokens. Change it for every customer.
JWT_SECRET=change-me-to-a-long-random-string
# Password given to the demo users on first start. Change it before a customer sees it.
DEMO_PASSWORD=meridian-demo
# Browser origins allowed to call the API (comma separated). * = any (demo only).
CORS_ORIGIN=http://localhost:3000,http://localhost:3100
