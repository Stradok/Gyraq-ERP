# Copy to .env next to docker-compose.yml. The stack refuses to start without DB_PASSWORD and JWT_SECRET.
DB_PASSWORD=run: openssl rand -hex 16
JWT_SECRET=run: openssl rand -hex 32
DEMO_PASSWORD=choose-a-private-12+-char-password
# The address people use in the browser for the web app. '*' is refused in production.
CORS_ORIGIN=https://erp.customer.com
# 127.0.0.1 = only this machine (put Caddy/nginx in front). 0.0.0.0 = open to the network (not recommended without TLS).
BIND_ADDR=127.0.0.1
# Set to 1 only when a reverse proxy in front of the API sets X-Forwarded-For (needed for correct login throttling).
TRUST_PROXY=0
# Real customer (blank company, one Owner account) instead of the demo:
# COMPANY_MODE=empty
# OWNER_EMAIL=owner@customer.com
# OWNER_NAME=Customer Owner
# OWNER_PASSWORD=at-least-8-characters
# AI (optional)
# AI_EDITION=demo|standard|premium
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
