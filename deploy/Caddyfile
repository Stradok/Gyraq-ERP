# One address for everything: the web app, the API and the live stream. Caddy gets and renews the HTTPS certificate by itself.
# DOMAIN comes from .env (install.sh sets it). Point the domain's DNS at this server first.
{$DOMAIN} {
	encode zstd gzip
	@api path /api/* /auth/* /health
	handle @api {
		# flush_interval -1: send the live-update stream to the browser immediately instead of buffering it
		reverse_proxy api:4000 { flush_interval -1 }
	}
	handle {
		reverse_proxy web:3000
	}
}
